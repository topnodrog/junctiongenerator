# Copy to .env (git-ignored). No secret or private key belongs in this file or
# in any Git-tracked file. DNS, TLS and backups are managed by the operator.
JGC_SEED_HOSTNAME=seed-b.example.org
JGC_ACME_EMAIL=operator@example.org

# This seed's public WebSocket URL and the other operators' bootstrap URLs.
# Every public seed MUST use wss://. Cleartext ws:// is accepted only for
# loopback, RFC 1918 addresses and single-label container hostnames.
JGC_ADVERTISE_URL=wss://seed-b.example.org
JGC_SEEDS=wss://seed-a.junctiongenerator.net,wss://seed-c.example.net

# Only one operator may produce blocks on the zero-value pilot network.
JGC_PRODUCE=false
JGC_PARTICIPATE=false

# Operator-only status access. Leave unset unless remote status is required;
# the private status listener stays bound to loopback by default.
# JGC_STATUS_TOKEN=
# JGC_ALLOW_PRIVATE_STATUS_ON_PUBLIC_BIND=false
