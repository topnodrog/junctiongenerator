FROM node:22.23.2-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build

FROM ollama/ollama:0.34.0 AS runtime
COPY --from=build /usr/local/ /usr/local/
WORKDIR /app
ENV NODE_ENV=testnet \
    HOME=/tmp \
    JGC_EXCHANGE_DIR=/exchange \
    JGC_MANAGE_OLLAMA=1 \
    JGC_OLLAMA_PULL=1 \
    OLLAMA_ENDPOINT=http://127.0.0.1:11434 \
    OLLAMA_MODELS=/models
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/dist ./dist
RUN mkdir -p /exchange /models && chown -R 10001:10001 /app /exchange /models
VOLUME ["/exchange", "/models"]
USER 10001:10001
ENTRYPOINT ["node", "dist/scripts/challenge-role.js"]
