# Junction Generator Environment Variables
# Copy to .env.local for local development

# Cloudflare Worker API URL
NEXT_PUBLIC_API_URL=https://jgt-mining-api.james-gordon.workers.dev

# Public JGC testnet explorer/faucet API (served by Seed A)
NEXT_PUBLIC_TESTNET_API_URL=https://seed-a.junctiongenerator.net

# WalletConnect Cloud Project ID (get one at https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=76b12a251338d0850a9de560e5a40503

# Bitmedia Publisher ID (get from https://bitmedia.io dashboard)
NEXT_PUBLIC_BITMEDIA_PUBLISHER_ID=

# ── Contract deployment (server-side; used by deploy*.js) ────────────────────
# Copy this file to .env (git-ignored) and fill these in. NEVER commit real values.
# Deployer private key for Base. Use a FRESH wallet whose key has NEVER been in a
# committed file — the previously committed key is compromised and must not be reused.
PRIVATE_KEY=
# Base mainnet RPC (the public default works without an API key).
BASE_RPC_URL=https://mainnet.base.org
# Community funnel
# Create a permanent or long-lived Discord invite and set it in Vercel.
NEXT_PUBLIC_DISCORD_INVITE_URL=
