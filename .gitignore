# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root and workspaces)
/node_modules
packages/*/node_modules
tools/*/node_modules
api/node_modules

# python (kb-crawler tool)
tools/*/.venv/
__pycache__/
*.pyc

/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
packages/*/coverage

# next.js
/.next/
packages/web/.next/
/out/
packages/web/out/

# jgc-node build output
packages/jgc-node/dist/
packages/jgc-node/rust/pkg/

# jgc-node local testnet (data + run script — never commit)
packages/jgc-node/testnet-data/
packages/jgc-node/run-testnet.ps1

# scripts staging (2BDeleted = pending review for removal)
scripts/2BDeleted/

# rust build artifacts (Cargo target dirs — multi-GB, never commit)
target/
packages/jgc-node/rust/target/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# secrets - never commit
.gh_token
.curlrc-gh
.curlrc-jg
packages/jgc-node/wallet.keystore.json
*.keystore.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.cf_token
.turso-token
.turso-url
api/.dev.vars
api/.wrangler
deployment-base.json
.deployment_wallet.json
